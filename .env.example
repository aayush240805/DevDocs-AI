# PostgreSQL + pgvector
POSTGRES_DB=devdocs
POSTGRES_USER=devdocs_user
POSTGRES_PASSWORD=devdocs_pass
POSTGRES_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/devdocs
DB_USERNAME=devdocs_user
DB_PASSWORD=devdocs_pass

# JWT Authentication (replace with a strong 256-bit+ Base64 secret in Phase 2)
JWT_SECRET=change-me-to-a-long-base64-encoded-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Google Gemini API (used in Phase 4+)
GEMINI_API_KEY=your-google-ai-studio-api-key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
